# Copy to .env (gitignored) for local `npm run deploy` / `npm run run:local`.
# In GitHub Actions, set these as repository variables/secrets instead (see README).

# Required: apex domain with an existing Route53 hosted zone in your AWS account.
DOMAIN_NAME=example.com

# Optional (defaults shown).
# SUBDOMAIN=games
# ALLOWED_ORIGINS=https://example.com,https://www.example.com (add https://localhost:port for testing)
# SCHEDULE_HOUR=3
# SCHEDULE_TIMEZONE=America/Los_Angeles
# TOP_N=10

# Optional: pin the hosted zone instead of looking it up at synth time.
# HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ

# Optional: defaults to the account of your current AWS credentials.
# AWS_ACCOUNT_ID=123456789012
